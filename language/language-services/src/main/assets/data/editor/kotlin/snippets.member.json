{
  "fun": {
    "desc": "Create a member function",
    "body": [
      "fun ${1:functionName}(${2:params}): ${3:ReturnType} {",
      "\t$0",
      "}"
    ]
  },
  "pfun": {
    "desc": "Create a private function",
    "body": [
      "private fun ${1:functionName}(${2:params}): ${3:ReturnType} {",
      "\t$0",
      "}"
    ]
  },
  "ofun": {
    "desc": "Create an override function",
    "body": [
      "override fun ${1:functionName}(${2:params}): ${3:ReturnType} {",
      "\t$0",
      "}"
    ]
  },
  "val": {
    "desc": "Create a val property",
    "body": [
      "val ${1:propertyName}: ${2:Type} = ${3:value}"
    ]
  },
  "var": {
    "desc": "Create a var property",
    "body": [
      "var ${1:propertyName}: ${2:Type} = ${3:value}"
    ]
  },
  "lateinit": {
    "desc": "Create a lateinit var",
    "body": [
      "lateinit var ${1:propertyName}: ${2:Type}"
    ]
  },
  "lazy": {
    "desc": "Create a lazy property",
    "body": [
      "val ${1:propertyName} by lazy {",
      "\t${2:initialization}",
      "}"
    ]
  },
  "constructor": {
    "desc": "Create a secondary constructor",
    "body": [
      "constructor(${1:params}) {",
      "\t$0",
      "}"
    ]
  },
  "companion": {
    "desc": "Create a companion object",
    "body": [
      "companion object {",
      "\t$0",
      "}"
    ]
  },
  "init": {
    "desc": "Create an init block",
    "body": [
      "init {",
      "\t$0",
      "}"
    ]
  }
}